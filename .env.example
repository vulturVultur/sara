# ── Phase 0 (fondations) ──────────────────────────────────────────────────
SUPABASE_URL=            # URL du projet Supabase (Project Settings → API)
SUPABASE_KEY=            # Clé service_role JWT (commence par eyJ...) — JAMAIS côté client
NODE_ENV=production      # laissé vide/absent en local (npm run dev)
PORT=3000

# ── Phase 2 (auth + espace client) ────────────────────────────────────────
# BASE_URL=               # https://sara.onrender.com (ou domaine custom)
# RESEND_API_KEY=         # emails (vérification, reset mot de passe)

# ── Phase 3 (paiement) ─────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=      # sk_live_... (ou sk_test_...)
# STRIPE_WEBHOOK_SECRET=  # whsec_...
# VITE_STRIPE_PUBLISHABLE_KEY=  # pk_live_... — exposée au client

# ── Phase 4 (suivi + notif patron) ────────────────────────────────────────
# ADMIN_SECRET=            # signe les liens Accepter/Refuser + protège /api/admin/*
# TELEGRAM_BOT_TOKEN=      # notif patron nouvelle commande
# TELEGRAM_CHAT_ID=

# ── Phase 5 (dashboard patron) ────────────────────────────────────────────
# BOSS_EMAIL=              # compte patron (accès dashboard via login normal)
# BOSS_PASSWORD=           # source de vérité, re-synchronisé au boot
